# The SAM3 integration keeps only this repository's adapter and version notes in
# Git.  The pinned upstream checkout, standalone Python, virtual environment,
# and uv cache are reconstructed locally (see integrations/sam3/README.md).
integrations/sam3/.uv-cache/
integrations/sam3/env/
integrations/sam3/python/
integrations/sam3/src/

